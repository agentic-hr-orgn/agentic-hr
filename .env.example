# === PLATFORM RUNTIME ===
APP_ENV=development
ENVIRONMENT=development
USE_FAKE_INTEGRATIONS=true
API_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# === CORE INFRASTRUCTURE (Local Docker) ===
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentic_hr
DATABASE_URL=postgresql+asyncpg://agentic_hr_app:agentic_hr_app_secret@localhost:5432/agentic_hr
REDIS_URL=
TEMPORAL_ADDRESS=

# === AI MODELS (ADR 003 & ADR 007: Model Routing Tiers) ===
STRONG_MODEL=gemini-3.8-flash
CHEAP_MODEL=gemini-3.5-flash-lite
REASONING_MODEL=claude-opus-5-5
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
INGEST_INLINE=false
ENABLE_LOCAL_OCR=false
STRONG_MODEL_API_KEY=
CHEAP_MODEL_API_KEY=
REASONING_MODEL_API_KEY=
EMBEDDING_MODEL_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# === CLERK AUTHENTICATION ===
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# === E2B (Code Sandbox) ===
E2B_API_KEY=

# === LANGFUSE (AI Monitoring) ===
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# === SENTRY (Error Tracking) ===
SENTRY_DSN=

# === GOOGLE OAUTH (ADR 006 - Least Privilege Whitelist) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === SENSITIVE FIELD ENCRYPTION (Stage 2 Phase 9: AES-256-GCM Envelope Encryption) ===
# 256-bit (32-byte) Base64-encoded Key Encryption Key (KEK) for local development only
FIELD_ENCRYPTION_KEY=
FIELD_ENCRYPTION_KEY_ID=dev-kek-v1

# === CENTRAL MODEL GATEWAY (Stage 2 Phase 11 & ADR 007) ===
# Cheap tier (e.g., gemini-3.8-flash / gemini-4-hydrogen / gemini-3.5-flash-lite)
CHEAP_MODEL_PROVIDER=
CHEAP_MODEL_ID=
CHEAP_MODEL_API_KEY=
# Strong tier (e.g., claude-sonnet-5-5 / gemini-4-argon / gemini-3.8-flash)
STRONG_MODEL_PROVIDER=
STRONG_MODEL_ID=
STRONG_MODEL_API_KEY=
# Reasoning tier (e.g., claude-opus-5-5)
REASONING_MODEL_PROVIDER=
REASONING_MODEL_ID=
REASONING_MODEL_API_KEY=
# Private tier (Strictly required for real sensitive HR PII - fail-closed)
PRIVATE_MODEL_PROVIDER=
PRIVATE_MODEL_ID=
PRIVATE_MODEL_API_KEY=
PRIVATE_MODEL_ENDPOINT=
LANGFUSE_TRACING_ENABLED=false

